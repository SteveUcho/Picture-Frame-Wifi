---
import "../styles/index.css";
import {
	Separator,
	Surface,
	Button,

} from "@heroui/react";

import { CustomForm } from "../components/CustomForm.tsx";
import { CustomField } from "../components/CustomField.tsx";
import { DevicePicker, demoDevices } from "../components/DevicePicker.tsx";

import { formInput } from "../utils/classNames";

---

<html class="dark" data-theme="dark">
	<head>
		<title>Picture Frame Wifi</title>
	</head>
	<body>
		<div class="p-3 h-dvh flex flex-col mt-1">
			<div class="flex gap-4 flex-1">
				<Surface className="w-fit rounded-xl p-2">
					<h1 class="text-xl font-bold pt-1 pb-2">Frames</h1>
					<Separator />
					<DevicePicker devices={demoDevices} className="mt-2" />
				</Surface>
				<Surface className="p-8 flex-1 rounded-xl">
					<p>
						Connect to the WiFi network to configure your picture
						frame.
					</p>
					<CustomForm client:load submitURL="/setSettings/:deviceId">
						<CustomField
							client:load
							name="deviceId"
							label="Device ID"
						/>
						<div>
							<label for="sleep-interval">Sleep Interval</label>
							<input
								type="text"
								id="sleep-interval"
								name="sleepInterval"
								class={formInput}
								placeholder="00:00:00"
							/>
						</div>
						<div>
							<label for="orientation">Orientation</label>
							<input
								type="text"
								id="orientation"
								name="orientation"
								class={formInput}
								placeholder="horizontal"
							/>
						</div>
						<Button type="submit" fullWidth> Set </Button>
					</CustomForm>
				</Surface>
			</div>
		</div>
	</body>
</html>
