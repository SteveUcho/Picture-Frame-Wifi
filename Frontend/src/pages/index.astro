---
import "../styles/index.css";
import { Separator, Surface } from "@heroui/react";

import { CustomForm } from "../components/CustomForm.tsx";
import { DevicePicker } from "../components/DevicePicker.tsx";
import { DarkModeToggle } from "../components/DarkModeToggle.tsx";
import { fetchWithBackend } from "../utils/fetch";

const res = await fetchWithBackend("/admin/getDevices");
const devices = await res.json();
---

<html class="dark bg-default dark:bg-background">
  <head>
    <title>Picture Frame Wifi</title>
  </head>
  <body>
    <div class="p-4 h-dvh flex gap-4 max-w-3xl mx-auto">
      <Surface className="w-fit rounded-xl p-2">
        <div class="flex justify-between items-center p-2">
          <h1 class="text-xl font-bold mr-4">Frames</h1>
          <DarkModeToggle client:load />
        </div>
        <Separator />
        <DevicePicker client:idle className="mt-2" devices={devices} />
      </Surface>
      <Surface className="p-8 flex-1 rounded-xl flex flex-col h-full">
        <CustomForm client:idle submitURL="/admin/setDeviceSettings/:deviceId" fetchURL="/admin/getDeviceSettings/:deviceId" />
      </Surface>
    </div>
  </body>
</html>
